{
  "$schema": "https://raw.githubusercontent.com/neoradar-project/schemas/refs/heads/main/systems/labels.schema.json",
  "altitudeFormat": {
    "belowTransition": {
      "prefix": "A",
      "digits": 2
    },
    "aboveTransition": {
      "digits": 3
    }
  },
  "ground": "#neoirma",
  "airborne": {
    "tagPositioning": {
      "minLeaderLength": 60,
      "maxLeaderLength": 150,
      "initialBearing": 45,
      "initialLeaderLength": 85
    },
    "styleDefaults": {
      "font": "B612MonoLFXX-Bold",
      "fontWeight": "normal",
      "fontSize": 13,
      "detailedBackgroundColor": [
        25,
        25,
        25
      ],
      "detailedBackgroundColorOpacity": 0.9,
      "detailedRoundedCorners": 2
    },
    "labels": [
      {
        "description": "Detailed, flights CoFrance shows through the altitude filter",
        "detailed": true,
        "applyWhen": "$orlyThroughFilter",
        "applyToFilterStates": [
          "kUnfiltered",
          "kUpperFiltered",
          "kLowerFiltered"
        ],
        "rows": [
          [
            {
              "itemName": "alertText",
              "applyWhen": "$isSafetyAlertUnacknowledged",
              "leftClick": "acknowledgeAlert",
              "color": [
                255,
                255,
                255
              ],
              "blinkColor": [
                220,
                60,
                40
              ],
              "backgroundColor": [
                220,
                60,
                40
              ],
              "padding": [
                1,
                3
              ]
            },
            {
              "itemName": "alertText",
              "applyWhen": "$isSafetyAlertAcknowledged",
              "leftClick": "acknowledgeAlert",
              "color": [
                255,
                255,
                255
              ],
              "backgroundColor": [
                220,
                60,
                40
              ],
              "padding": [
                1,
                3
              ]
            },
            {
              "itemName": "alertText",
              "applyWhen": "$isSafetyWarning",
              "leftClick": "acknowledgeAlert",
              "color": [
                20,
                20,
                20
              ],
              "backgroundColor": [
                241,
                111,
                34
              ],
              "padding": [
                1,
                3
              ]
            },
            {
              "itemName": "manualAlert",
              "mapping": {
                "0": "",
                "1": "MISAP",
                "2": "INBEST",
                "3": "IRREG",
                "4": "WX"
              },
              "color": [
                230,
                200,
                70
              ]
            }
          ],
          [
            {
              "itemName": "groundSpeed",
              "padWithZeroLeft": 3,
              "truncate": [
                0,
                2
              ]
            },
            {
              "itemName": "assignedMach",
              "padWithZeroLeft": 3,
              "truncate": [
                0,
                3
              ],
              "prefix": "m",
              "leftClick": "spd",
              "rightClick": "clearSpd"
            },
            {
              "itemName": "computedSpeed",
              "prefix": "k",
              "placeholder": "k..",
              "leftClick": "spd",
              "rightClick": "clearSpd"
            },
            {
              "itemName": "verticalSpeed",
              "truncate": [
                0,
                3
              ],
              "showPlusMinus": true,
              "color": [
                255,
                255,
                255
              ],
              "backgroundColor": [
                218,
                89,
                50
              ],
              "applyWhen": "$isEmmergencyDescending"
            },
            {
              "itemName": "text",
              "value": [
                "=emmergencyDescentArrow"
              ],
              "fontWeight": "bold",
              "color": [
                218,
                89,
                50
              ],
              "backgroundColor": [
                1,
                1,
                1
              ]
            },
            {
              "itemName": "scratchpad",
              "placeholder": "...",
              "color": "=blueColorScratchpadNotEmpty",
              "leftClick": "triggerScratchpad"
            },
            {
              "itemName": "verticalSpeed",
              "padWithZeroLeft": 4,
              "truncate": [
                0,
                3
              ],
              "showPlusMinus": true
            },
            {
              "itemName": "acShortType"
            }
          ],
          [
            {
              "itemName": "callsign",
              "applyWhen": "$hasCallsignBox",
              "leftClick": "callsignMenu",
              "color": [
                "=incomingTransferText",
                "=assumedText"
              ],
              "backgroundColor": [
                "=incomingTransferBox",
                "=assumedBox"
              ],
              "padding": [
                1,
                3
              ]
            },
            {
              "itemName": "callsign",
              "applyWhen": "$hasNoCallsignBox",
              "leftClick": "callsignMenu",
              "color": [
                "=handoffText"
              ],
              "padding": [
                1,
                0
              ]
            },
            {
              "itemName": "voiceType",
              "leftClick": "voiceTypeMenu",
              "mapping": {
                "0": "/v",
                "1": "/r",
                "2": "/t"
              },
              "color": [
                255,
                220,
                3
              ]
            },
            {
              "itemName": "text",
              "truncate": [
                0,
                3
              ],
              "color": [
                29,
                118,
                226
              ],
              "value": [
                "=emptySIDifNotDep",
                "=suggestedSidIfNoAssigned",
                "&sid"
              ],
              "leftClick": "sidMenu"
            },
            {
              "itemName": "nextControllerFrequency",
              "applyWhen": "$isOutboundTransfer",
              "color": [
                160,
                216,
                180
              ]
            },
            {
              "itemName": "sectorIndicator",
              "placeholder": "---"
            },
            {
              "itemName": "plannedFlightLevel",
              "padWithZeroLeft": 5,
              "truncate": [
                0,
                2
              ],
              "placeholder": "TaFL",
              "leftClick": "pfl"
            }
          ],
          [
            {
              "itemName": "computedAltitude",
              "format": "altitude",
              "leftClick": "routeDraw"
            },
            {
              "itemName": "verticalTrend",
              "placeholder": "—",
              "mapping": {
                "0": "—",
                "1": "↗",
                "-1": "↘"
              }
            },
            {
              "itemName": "databaseIcaoWakeCat",
              "placeholder": "Z"
            },
            {
              "itemName": "clearedFlightLevel",
              "padWithZeroLeft": 5,
              "truncate": [
                0,
                2
              ],
              "mapping": {
                "1": "CA",
                "2": "VA"
              },
              "placeholder": "cfl",
              "leftClick": "cfl"
            },
            {
              "itemName": "assignedDirect",
              "leftClick": "directMenu",
              "rightClick": "triggerScratchpad"
            },
            {
              "itemName": "assignedHeading",
              "padWithZeroLeft": 3,
              "truncate": [
                0,
                3
              ],
              "placeholder": "h...",
              "prefix": "h",
              "leftClick": "hdg",
              "rightClick": "directMenu"
            }
          ],
          [
            {
              "itemName": "reportedHeading",
              "padWithZeroLeft": 3,
              "truncate": [
                0,
                3
              ],
              "placeholder": "@h...",
              "prefix": "@h"
            },
            {
              "itemName": "origin",
              "placeholder": "ORIG",
              "leftClick": "fpDialog"
            },
            {
              "itemName": "destination",
              "placeholder": "DEST",
              "leftClick": "fpDialog"
            }
          ]
        ]
      },
