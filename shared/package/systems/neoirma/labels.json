              "mapping": {
                "0": "",
                "1": "/r",
                "2": "/t"
              },
              "color": [255, 220, 3]
            },
            {
              "itemName": "acShortType",
              "placeholder": "ATYP",
              "leftClick": "fpDialog"
            }
          ],
          [
            {
              "itemName": "scratchpad",
