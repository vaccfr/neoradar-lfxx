        "$cdgDepSA",
        "$cdgDepSL",
        "$cdgDepSO",
        "$cdgDepSP",
        "$cdgDepWE",
        "$cdgDepWL",
        "$cdgDepHO",
        "$cdgDepHM",
        "$cdgDepHD",
        "$cdgDepOrly",
        "$cdgDepPTOB",
        "$cdgDepCDG",
        "$isOwnedOrOffered"
      ]
    ],
    "cdgAssumedBoxLocalPGPB": ["AND", ["$isAssumed", ["OR", ["$cdgLocalPGPB", "$cdgLocalOrly"]]]],
    "cdgAssumedBoxArrSouth": ["AND", ["$isAssumed", "$cdgArrSouth"]],
    "cdgAssumedBoxArrNorth": ["AND", ["$isAssumed", "$cdgArrNorth"]],
    "cdgAssumedBoxArrBourget": ["AND", ["$isAssumed", "$cdgArrBourget"]],
    "cdgAssumedBoxArrOrly": ["AND", ["$isAssumed", ["OR", ["$cdgArrOrly", "$cdgArrPTOB"]]]],
    "cdgAssumedBoxArrPNPV": ["AND", ["$isAssumed", "$cdgArrPNPV"]],
    "cdgAssumedBoxArrCDG": ["AND", ["$isAssumed", "$cdgArrCDG"]],
    "cdgAssumedBoxDepNN": [
      "AND",
      [
        "$isAssumed",
        [
          "OR",
          [
            "$cdgDepNN",
            "$cdgDepNO",
            "$cdgDepNA",
            "$cdgDepNM",
            "$cdgDepER",
            "$cdgDepEL",
            "$cdgDepEB",
            "$cdgDepEN",
            "$cdgDepED",
            "$cdgDepEX",
            "$cdgDepSE",
            "$cdgDepSA",
            "$cdgDepSL",
            "$cdgDepSO",
