  "expressions": {
    "isAssumed": ["==", "attentionState", "3"],
    "isInboundTransfer": ["==", "attentionState", "2"],
    "isOutboundTransfer": ["==", "attentionState", "4"],
    "isOwnedOrOffered": ["OR", ["$isInboundTransfer", "$isAssumed", "$isOutboundTransfer"]],
    "hasCallsignBox": ["OR", ["$isInboundTransfer", "$isAssumed"]],
    "hasNoCallsignBox": ["NOT", ["$isInboundTransfer", "$isAssumed"]],
    "isIFR": ["contains", "flightRule", "I"],
    "neoirmaDep": ["==", "isDeparture", "1"],
    "neoirmaArr": ["==", "isArrival", "1"],
    "neoirmaThroughFilter": ["OR", ["$neoirmaDep", "$neoirmaArr", "$isOwnedOrOffered"]],
    "cdgLocalPGPB": [
      "AND",
      [
        ["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]],
        ["OR", [["==", "destination", "LFPG"], ["==", "destination", "LFPB"]]]
      ]
    ],
    "cdgLocalOrly": [
      "AND",
      [
        ["OR", [["==", "origin", "LFPO"], ["==", "origin", "LFPN"], ["==", "origin", "LFPV"]]],
        [
          "OR",
          [["==", "destination", "LFPO"], ["==", "destination", "LFPN"], ["==", "destination", "LFPV"]]
        ]
      ]
    ],
    "cdgArrSouth": [
      "AND",
      [
        ["==", "destination", "LFPG"],
        "$isIFR",
        [
          "OR",
          [
            [
              "OR",
              [
                ["==", "arrRunway", "08L"],
                ["==", "arrRunway", "08R"],
                ["==", "arrRunway", "26L"],
                ["==", "arrRunway", "26R"]
              ]
            ],
            [
              "AND",
              [
                ["isEmpty", "arrRunway"],
                [
                  "OR",
                  [
                    ["==", "suggestedArrRunway", "08L"],
                    ["==", "suggestedArrRunway", "08R"],
                    ["==", "suggestedArrRunway", "26L"],
                    ["==", "suggestedArrRunway", "26R"]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    "cdgArrNorth": [
      "AND",
      [
        ["==", "destination", "LFPG"],
        [
          "OR",
          [
            [
              "OR",
              [
                ["==", "arrRunway", "09L"],
                ["==", "arrRunway", "09R"],
                ["==", "arrRunway", "27L"],
                ["==", "arrRunway", "27R"]
              ]
            ],
            [
              "AND",
              [
                ["isEmpty", "arrRunway"],
                [
                  "OR",
                  [
                    ["==", "suggestedArrRunway", "09L"],
                    ["==", "suggestedArrRunway", "09R"],
                    ["==", "suggestedArrRunway", "27L"],
                    ["==", "suggestedArrRunway", "27R"]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    ],
    "cdgArrBourget": ["==", "destination", "LFPB"],
    "cdgArrOrly": ["==", "destination", "LFPO"],
    "cdgArrPTOB": ["AND", [["OR", [["==", "destination", "LFPT"], ["==", "destination", "LFOB"]]], "$isIFR"]],
    "cdgArrPNPV": ["OR", [["==", "destination", "LFPN"], ["==", "destination", "LFPV"]]],
    "cdgArrCDG": ["==", "destination", "LFPG"],
    "cdgDepNN": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "NURMO"]]
    ],
    "cdgDepNO": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "OPALE"]]
    ],
    "cdgDepNA": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "ATREX"]]
    ],
    "cdgDepNM": ["AND", [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "MTD"]]],
    "cdgDepER": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "RANUX"]]
    ],
    "cdgDepEL": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "LANVI"]]
    ],
    "cdgDepEB": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "BUBLI"]]
    ],
    "cdgDepEN": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "NIPOR"]]
    ],
    "cdgDepED": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "DIKOL"]]
    ],
    "cdgDepEX": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "BAXIR"]]
    ],
    "cdgDepSE": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "ERIXU"]]
    ],
    "cdgDepSA": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "AGOPA"]]
    ],
    "cdgDepSL": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "LATRA"]]
    ],
    "cdgDepSO": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "OKASI"]]
    ],
    "cdgDepSP": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "PILUL"]]
    ],
    "cdgDepWE": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "ELCOB"]]
    ],
    "cdgDepWL": ["AND", [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "LGL"]]],
    "cdgDepHO": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "OLZOM"]]
    ],
    "cdgDepHM": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "MONOT"]]
    ],
    "cdgDepHD": [
      "AND",
      [["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]], ["has", "waypoints", "DORDI"]]
    ],
    "cdgDepOrly": ["OR", [["==", "origin", "LFPO"], ["==", "origin", "LFPN"], ["==", "origin", "LFPV"]]],
    "cdgDepPTOB": ["AND", [["OR", [["==", "origin", "LFPT"], ["==", "origin", "LFOB"]]], "$isIFR"]],
    "cdgDepCDG": ["OR", [["==", "origin", "LFPG"], ["==", "origin", "LFPB"]]],
    "cdgVFR": ["contains", "flightRule", "V"],
    "cdgThroughFilter": [
      "OR",
      [
        "$cdgLocalPGPB",
        "$cdgLocalOrly",
        "$cdgArrSouth",
        "$cdgArrNorth",
        "$cdgArrBourget",
        "$cdgArrOrly",
        "$cdgArrPTOB",
        "$cdgArrPNPV",
        "$cdgArrCDG",
        "$cdgDepNN",
        "$cdgDepNO",
        "$cdgDepNA",
        "$cdgDepNM",
        "$cdgDepER",
        "$cdgDepEL",
        "$cdgDepEB",
        "$cdgDepEN",
        "$cdgDepED",
        "$cdgDepEX",
        "$cdgDepSE",
        "$cdgDepSA",
        "$cdgDepSL",
        "$cdgDepSO",
        "$cdgDepSP",
        "$cdgDepWE",
        "$cdgDepWL",
        "$cdgDepHO",
        "$cdgDepHM",
        "$cdgDepHD",
        "$cdgDepOrly",
        "$cdgDepPTOB",
        "$cdgDepCDG",
        "$isOwnedOrOffered"
      ]
    ],
    "hasAcknowledgmentState": [
      "AND",
      [
        ["==", "isPDCRequested", "0"],
        ["==", "hasReceivedHoppieMessage", "0"],
        ["==", "hasCPDLCAcknowledgment", "1"]
      ]
    ],
    "hasReceivedMessageState": ["AND", [["==", "isPDCRequested", "0"], ["==", "hasReceivedHoppieMessage", "1"]]],
    "hasRejectedAcknowledgmentState": [
      "AND",
      [
        ["==", "isPDCRequested", "0"],
        ["==", "hasReceivedHoppieMessage", "0"],
        ["==", "hasCPDLCUnableAcknowledgment", "1"]
      ]
    ],
    "hasSentMessageState": [
      "AND",
      [
        ["==", "isPDCRequested", "0"],
        ["==", "hasReceivedHoppieMessage", "0"],
        ["==", "hasCPDLCAcknowledgment", "0"],
        ["==", "hasCPDLCSentMessage", "1"]
      ]
    ],
    "incorrectSquawk": ["!=", "squawk", "&assignedSquawk"],
    "isAboveTransitionAltitude": [">=", "altitude", "&transitionAltitude"],
    "isAssignedArrRunwayEmpty": ["isEmpty", "arrRunway"],
    "isAssignedArrRunwayNotEmpty": ["notEmpty", "arrRunway"],
    "isAssignedDepRunwayEmpty": ["isEmpty", "depRunway"],
    "isAssignedDepRunwayNotEmpty": ["notEmpty", "depRunway"],
    "isAssignedSidEmpty": ["isEmpty", "sid"],
    "isAssignedSidNotEmpty": ["notEmpty", "sid"],
    "isAssignedStarEmpty": ["isEmpty", "star"],
    "isAssignedStarNotEmpty": ["notEmpty", "star"],
    "isBelowTransitionAltitude": ["<", "altitude", "&transitionAltitude"],
    "isConcerned": ["==", "attentionState", "1"],
    "isControllerTimingOut": ["==", "controllerIsTimingOut", "1"],
    "isDefaultDatalinkState": [
      "AND",
      [
        ["==", "isPDCRequested", "0"],
        ["==", "hasReceivedHoppieMessage", "0"],
        ["==", "hasCPDLCAcknowledgment", "0"],
        ["==", "hasCPDLCSentMessage", "0"]
      ]
    ],
    "isEmmergencyDescending": ["<=", "verticalSpeed", -4000],
    "isFocusedAircraft": ["==", "focusedAircraftCallsign", "&callsign"],
    "isNotDep": ["==", "isDeparture", "0"],
    "isPDCRequestedState": ["==", "isPDCRequested", "1"],
    "isUnconcerned": ["==", "attentionState", "0"],
    "noAssignedSquawk": ["==", "assignedSquawk", "0000"],
    "scratchPathNotEmpty": ["notEmpty", "scratchpad"],
    "isSafetyAlert": [">=", "alertSeverity", "3"],
    "isSafetyAlertUnacknowledged": ["AND", [[">=", "alertSeverity", "3"], ["==", "alertAcknowledged", "0"]]],
    "isSafetyAlertAcknowledged": ["AND", [[">=", "alertSeverity", "3"], ["==", "alertAcknowledged", "1"]]],
    "isSafetyWarning": ["==", "alertSeverity", "2"],
    "isTrack": ["!=", "callsign", ""]
  }
